{
  "name": "wordfinderapp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:arch": "node scripts/check-architecture.mjs",
    "ci": "npm run check:arch && npm run test && npm run build:frontend",
    "build:frontend": "vite build",
    "build:windows": "tauri build --no-bundle",
    "build:macos": "tauri build --target universal-apple-darwin --bundles dmg",
    "clean": "cargo clean --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@lucide/vue": "^1.22.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "buffer": "^6.0.3",
    "exceljs": "^4.4.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.1.200",
    "pinia": "^3.0.4",
    "pretendard": "^1.3.9",
    "vue": "^3.5.13",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.7",
    "@tailwindcss/vite": "^4.3.2",
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^3.2.7",
    "tailwindcss": "^4.3.2",
    "vite": "^6.0.3",
    "vitest": "^3.2.7"
  }
}
